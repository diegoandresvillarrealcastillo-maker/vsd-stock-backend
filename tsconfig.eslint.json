{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.mts",
    "vitest.integration.config.mts",
    "vitest.benchmark.config.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
