# Copia este archivo como .env y ajusta los valores.
# El .env nunca se sube al repositorio: lo ignora .gitignore y lo vigila gitleaks.

# Puerto en el que escucha la API: entero entre 1 y 65535. Por defecto, 3000.
PORT=3000

# Origenes a los que se les permite leer las respuestas de la API desde un navegador,
# separados por comas. Cada uno con la forma esquema://host[:puerto], en minusculas,
# sin ruta ni barra final. No admite "*". Sin esta variable no se permite ninguno.
# Este valor sirve para trabajar con el frontend local (npm run dev).
CORS_ORIGINS=http://localhost:5173

# Cadena de conexion del rol DUENO de las tablas, la que usa `npm run db:migrate` y el CLI de Prisma. NO es la de la
# aplicacion y no la lee la API. Lleva contrasena en un ambiente real: va en tu .env, nunca en este archivo ni en el
# chat. Para la base local de Docker (`npm run db:up`) no hace falta; usa `npm run db:prepare`. Ver docs/ambientes.md.
# DATABASE_MIGRATION_URL=postgresql://postgres.TU-REF:CONTRASENA@HOST-DEL-POOLER:5432/postgres
