{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "No requiere sesión y no toca la base de datos. El cliente lo usa para confirmar que hay conexión de verdad: navigator.onLine solo es una pista.",
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "El servicio responde.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReportDto"
                }
              }
            }
          },
          "default": {
            "description": "Cualquier error. El cuerpo es un `application/problem+json` (RFC 9457): el cliente se guía por `code` y por el estado HTTP, no por el texto.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Comprueba que el servicio está en pie",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/ready": {
      "get": {
        "description": "No requiere sesión. Comprueba lo que el servicio necesita para trabajar: hoy, la base de datos. Responde 503 con `database-unavailable` si la base no responde y con `database-not-configured` si nunca se configuró.",
        "operationId": "ReadinessController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "El servicio está listo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReportDto"
                }
              }
            }
          },
          "default": {
            "description": "Cualquier error. El cuerpo es un `application/problem+json` (RFC 9457): el cliente se guía por `code` y por el estado HTTP, no por el texto.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Comprueba que el servicio puede atender peticiones de negocio",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "description": "Devuelve a la persona que demuestra el token y, si ya tiene negocio, el suyo y su rol. El negocio y el rol salen de la base de datos, nunca del token. Una persona que se registró pero aún no tiene negocio recibe `membership: null`. Responde 401 si el token falta o no sirve (`token-expired` si solo venció) y 403 `user-inactive` si fue dada de baja.",
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "La persona y su lugar en el negocio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          },
          "default": {
            "description": "Cualquier error. El cuerpo es un `application/problem+json` (RFC 9457): el cliente se guía por `code` y por el estado HTTP, no por el texto.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Quién soy",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/businesses": {
      "post": {
        "description": "Lo hace quien se registró y aún no pertenece a ningún negocio: queda como su dueño. El negocio nace con una sucursal y una bodega, ambas «Principal». Responde 409 `already-member` si la persona ya trabaja en un negocio.",
        "operationId": "BusinessesController_open",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBusinessRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "El lugar de la persona en el negocio nuevo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeMembershipDto"
                }
              }
            }
          },
          "default": {
            "description": "Cualquier error. El cuerpo es un `application/problem+json` (RFC 9457): el cliente se guía por `code` y por el estado HTTP, no por el texto.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Abrir un negocio",
        "tags": [
          "business"
        ]
      }
    },
    "/v1/invitations": {
      "post": {
        "description": "Crea la invitación y devuelve su código **una sola vez**. El servidor solo guarda su hash. La invitación vale siete días. Un administrador invita cajeros; invitar administradores es del dueño.",
        "operationId": "InvitationsController_invite",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteUserRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationDto"
                }
              }
            }
          },
          "default": {
            "description": "Cualquier error. El cuerpo es un `application/problem+json` (RFC 9457): el cliente se guía por `code` y por el estado HTTP, no por el texto.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Invitar a alguien al negocio",
        "tags": [
          "people"
        ]
      }
    },
    "/v1/invitations/redeem": {
      "post": {
        "description": "Une a quien llama al negocio del código, con el rol con que lo invitaron. Un código sirve una sola vez. Responde 404 `invitation-not-found` si no existe, ya se usó o se dio de baja (el mismo mensaje para todo), 410 `invitation-expired` si venció y 409 `already-member` si la persona ya trabaja en un negocio.",
        "operationId": "InvitationsController_redeem",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemInvitationRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "El lugar de la persona en el negocio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeMembershipDto"
                }
              }
            }
          },
          "default": {
            "description": "Cualquier error. El cuerpo es un `application/problem+json` (RFC 9457): el cliente se guía por `code` y por el estado HTTP, no por el texto.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Canjear una invitación",
        "tags": [
          "people"
        ]
      }
    },
    "/v1/users": {
      "get": {
        "description": "Ordenadas por nombre. Las ve la gerencia (dueño y administradores). Pagina por cursor (ADR 0019).",
        "operationId": "UsersController_list",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "El `nextCursor` de la página anterior, tal cual."
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonPageDto"
                }
              }
            }
          },
          "default": {
            "description": "Cualquier error. El cuerpo es un `application/problem+json` (RFC 9457): el cliente se guía por `code` y por el estado HTTP, no por el texto.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Las personas del negocio",
        "tags": [
          "people"
        ]
      }
    },
    "/v1/users/{userId}": {
      "patch": {
        "description": "Cambia el nombre, el rol o el alta (`active`). Al cajero lo administra la gerencia; a un administrador o a un dueño, solo el dueño. Nunca deja al negocio sin un dueño activo (409 `last-owner`). Una persona dada de baja pierde el acceso en su siguiente petición.",
        "operationId": "UsersController_update",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonDto"
                }
              }
            }
          },
          "default": {
            "description": "Cualquier error. El cuerpo es un `application/problem+json` (RFC 9457): el cliente se guía por `code` y por el estado HTTP, no por el texto.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cambiar a una persona",
        "tags": [
          "people"
        ]
      }
    },
    "/v1/users/{userId}/invitation": {
      "post": {
        "description": "Da un código nuevo a una invitación pendiente (se perdió o venció); el anterior deja de servir. Responde 409 `invitation-not-pending` si la persona ya canjeó la suya o está dada de baja.",
        "operationId": "UsersController_renew",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationDto"
                }
              }
            }
          },
          "default": {
            "description": "Cualquier error. El cuerpo es un `application/problem+json` (RFC 9457): el cliente se guía por `code` y por el estado HTTP, no por el texto.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Renovar una invitación",
        "tags": [
          "people"
        ]
      }
    }
  },
  "info": {
    "title": "VSD Stock API",
    "description": "API de VSD Stock: inventario, punto de venta, caja y reportes para MiPymes. Este documento es el contrato que une al backend con el frontend (ADR 0001).",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthReportDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok",
            "description": "Estado del servicio. Hoy solo existe «ok»: si no responde, está caído."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-16T15:30:00.000Z",
            "description": "Instante en que se comprobó el servicio, en ISO 8601 y en UTC."
          }
        },
        "required": [
          "status",
          "timestamp"
        ]
      },
      "ReadinessReportDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok",
            "description": "Siempre «ok» en una respuesta 200: si el servicio no está listo, responde 503."
          },
          "database": {
            "type": "string",
            "enum": [
              "up"
            ],
            "example": "up",
            "description": "La base de datos responde."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-17T15:30:00.000Z",
            "description": "Instante en que se comprobó, en ISO 8601 y en UTC."
          }
        },
        "required": [
          "status",
          "database",
          "timestamp"
        ]
      },
      "MeIdentityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "El identificador de la persona en el servicio de identidad (el `sub` del token)."
          },
          "email": {
            "type": "string",
            "nullable": true,
            "description": "El correo con que se registró, si lo tiene."
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "MeMembershipDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "La persona dentro del negocio."
          },
          "businessId": {
            "type": "string",
            "format": "uuid"
          },
          "businessName": {
            "type": "string",
            "example": "Tienda La Esquina"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "cashier"
            ],
            "description": "Su rol en este negocio. Sale de la base de datos, nunca del token."
          },
          "fullName": {
            "type": "string",
            "example": "Ana Gómez"
          }
        },
        "required": [
          "userId",
          "businessId",
          "businessName",
          "role",
          "fullName"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "identity": {
            "$ref": "#/components/schemas/MeIdentityDto"
          },
          "membership": {
            "nullable": true,
            "description": "Su lugar en un negocio. `null` si se registró pero aún no creó un negocio ni canjeó una invitación.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/MeMembershipDto"
              }
            ]
          }
        },
        "required": [
          "identity",
          "membership"
        ]
      },
      "CreateBusinessRequestDto": {
        "type": "object",
        "properties": {
          "businessName": {
            "type": "string",
            "maxLength": 120,
            "example": "Tienda La Esquina"
          },
          "ownerName": {
            "type": "string",
            "maxLength": 120,
            "example": "Ana Gómez",
            "description": "Cómo se llama quien lo abre."
          }
        },
        "required": [
          "businessName",
          "ownerName"
        ]
      },
      "InviteUserRequestDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "maxLength": 120,
            "example": "Luis Pérez"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "cashier"
            ],
            "description": "Administrador o cajero. Un administrador solo puede invitar cajeros; invitar administradores es del dueño. No se invita a un dueño: se nombra cambiando el rol de una persona que ya está."
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "example": "luis@ejemplo.co",
            "description": "Opcional. Se guarda en minúsculas. No se envía ningún correo."
          }
        },
        "required": [
          "fullName",
          "role"
        ]
      },
      "PersonDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string",
            "example": "Luis Pérez"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "cashier"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "pending",
              "inactive"
            ],
            "description": "`pending` es una invitación que nadie canjeó; `inactive`, una persona (o invitación) dada de baja."
          },
          "invitationExpiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Hasta cuándo vale su invitación, mientras esté pendiente."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "fullName",
          "email",
          "role",
          "status",
          "invitationExpiresAt",
          "createdAt"
        ]
      },
      "InvitationCodeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "0123-4567-89AB-CDEF",
            "description": "El código de la invitación, de cuatro en cuatro para dictarlo. **Se muestra una sola vez**: el servidor solo guarda su hash. Si se pierde, se renueva."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "code",
          "expiresAt"
        ]
      },
      "InvitationDto": {
        "type": "object",
        "properties": {
          "person": {
            "$ref": "#/components/schemas/PersonDto"
          },
          "invitation": {
            "$ref": "#/components/schemas/InvitationCodeDto"
          }
        },
        "required": [
          "person",
          "invitation"
        ]
      },
      "RedeemInvitationRequestDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "0123-4567-89AB-CDEF",
            "description": "El código que dieron a la persona. Se acepta en mayúsculas o minúsculas, con o sin guiones y espacios."
          }
        },
        "required": [
          "code"
        ]
      },
      "PersonPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Se pasa tal cual como `cursor` para pedir la página siguiente. `null` si no hay más. Es opaco: no se interpreta."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "UpdateUserRequestDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "cashier"
            ],
            "description": "Cambiar el rol de un cajero a administrador, o de cualquiera a dueño, es del dueño."
          },
          "active": {
            "type": "boolean",
            "description": "`false` da de baja a la persona (o revoca su invitación); `true` la reactiva. No se puede dar de baja al último dueño."
          }
        }
      },
      "ProblemErrorDto": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "example": "/lines/0/quantityMilli",
            "description": "Puntero JSON (RFC 6901) al campo de la peticion que no sirve."
          },
          "code": {
            "type": "string",
            "example": "out-of-range",
            "description": "Código estable del problema de ese campo, para que el cliente decida qué mostrar."
          },
          "detail": {
            "type": "string",
            "description": "Explicación para quien programa. No es un texto para la persona usuaria."
          }
        },
        "required": [
          "pointer",
          "code",
          "detail"
        ]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "urn:vsd-stock:problem:not-found",
            "description": "Identifica el tipo de error. Siempre `urn:vsd-stock:problem:` seguido del `code`."
          },
          "title": {
            "type": "string",
            "example": "No encontrado",
            "description": "Resumen corto del tipo de error."
          },
          "status": {
            "type": "integer",
            "example": 404,
            "description": "El estado HTTP de la respuesta."
          },
          "detail": {
            "type": "string",
            "description": "Explicación de esta ocurrencia, para quien programa. Un error inesperado no revela su causa: solo trae el `traceId`."
          },
          "instance": {
            "type": "string",
            "example": "/v1/products/3f0c9d58-8f6e-4f0a-9f0e-0d1d2a6b7c11",
            "description": "La ruta que falló, sin cadena de consulta (puede llevar datos)."
          },
          "code": {
            "type": "string",
            "example": "not-found",
            "description": "Código estable con que el cliente reconoce el error. Es lo único en lo que debe apoyarse para decidir qué hacer; `title` y `detail` pueden cambiar."
          },
          "traceId": {
            "type": "string",
            "example": "3f0c9d58-8f6e-4f0a-9f0e-0d1d2a6b7c11",
            "description": "Identificador de seguimiento. Es el `X-Request-Id` de la petición, que el cliente puede haber enviado, y aparece en el registro del servidor."
          },
          "errors": {
            "description": "Los campos inválidos, cuando el error es de validación.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemErrorDto"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "traceId"
        ]
      }
    }
  }
}
